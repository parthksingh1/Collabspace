{
  "name": "collabspace",
  "version": "1.0.0",
  "private": true,
  "description": "CollabSpace — AI-powered collaboration operating system",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "tsx --test tests/integration/crdt-convergence.test.ts tests/integration/offline-reconciliation.test.ts",
    "test:chaos": "npm run test:chaos:ws && npm run test:chaos:redis",
    "test:e2e": "playwright test --config tests/e2e/playwright/playwright.config.ts",
    "test:all": "npm run test && npm run test:integration && npm run test:chaos",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "turbo run db:migrate --filter=@collabspace/doc-service --filter=@collabspace/code-service --filter=@collabspace/project-service --filter=@collabspace/auth-service",
    "db:seed": "turbo run db:seed",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:seed:demo:reset": "tsx scripts/seed-demo.ts --reset",
    "docker:build": "docker compose -f infra/docker/docker-compose.yml --project-directory . --env-file .env build",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml --project-directory . --env-file .env up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml --project-directory . --env-file .env down",
    "k8s:deploy": "kubectl apply -k infra/k8s/overlays/production",
    "load-test": "k6 run tests/load/scenarios.js",
    "bench:ws": "k6 run benchmarks/websocket-load.js",
    "bench:crdt": "tsx benchmarks/crdt-sync-latency.ts",
    "bench:api": "k6 run benchmarks/api-throughput.js",
    "bench:all": "npm run bench:ws && npm run bench:crdt && npm run bench:api",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test:chaos:ws": "tsx --test tests/chaos/ws-node-failure.test.ts",
    "test:chaos:redis": "tsx --test tests/chaos/redis-restart.test.ts",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml --project-directory . --env-file .env logs -f",
    "docker:infra": "docker compose -f infra/docker/docker-compose.yml --project-directory . --env-file .env up -d postgres redis kafka zookeeper prometheus grafana jaeger"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.10",
    "bcryptjs": "^2.4.3",
    "eslint": "^8.56.0",
    "pg": "^8.11.0",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "ws": "^8.16.0",
    "yjs": "^13.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.0.0"
}
