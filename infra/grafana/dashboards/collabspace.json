      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "editorMode": "code",
          "expr": "sum by (agent) (rate(collabspace_ai_agent_calls_total{status=\"success\"}[1h])) / clamp_min(sum by (agent) (rate(collabspace_ai_agent_calls_total[1h])), 0.0001)",
          "legendFormat": "{{agent}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 33,
