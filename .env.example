# ─── CollabSpace Environment Configuration ───

# Application
NODE_ENV=development
APP_PORT=3000
API_GATEWAY_PORT=4000
WS_GATEWAY_PORT=4001

# Supabase (PostgreSQL)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/collabspace

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CLUSTER_NODES=localhost:6379,localhost:6380,localhost:6381

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=collabspace
KAFKA_GROUP_ID=collabspace-group

# Authentication
JWT_SECRET=your-jwt-secret-min-256-bits
JWT_REFRESH_SECRET=your-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# AI Services
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai

# Vector Database
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east1-gcp
PINECONE_INDEX=collabspace-memory

# WebRTC
TURN_SERVER_URL=turn:turn.collabspace.io:3478
TURN_USERNAME=collabspace
TURN_CREDENTIAL=your-turn-credential

# Storage
S3_BUCKET=collabspace-assets
S3_REGION=us-east-1
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Email (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key

# Encryption
ENCRYPTION_KEY=your-256-bit-encryption-key
E2E_ENCRYPTION_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose
# ─────────────────────────────────────────────────────────────────────────────
# Everything below is read by infra/docker/docker-compose.yml. The values here
# are working development defaults — `cp .env.example .env` and `docker compose
# up` should work with no edits. Only the AI keys need real values, and only if
# you want the AI features to do anything.

# Postgres. POSTGRES_PASSWORD has NO default in docker-compose.yml, and the
# official postgres image refuses to initialise without one, so omitting this
# breaks the whole stack on first run.
POSTGRES_USER=collabspace
POSTGRES_PASSWORD=collabspace_dev_password
POSTGRES_DB=collabspace
POSTGRES_PORT=5432

# Redis. Empty password is intentional for local development; the compose file
# passes it to `--requirepass`, and an empty value disables auth.
REDIS_PASSWORD=
REDIS_PORT=6379

# Service ports
WEB_PORT=3000
AUTH_SERVICE_PORT=4002
DOC_SERVICE_PORT=4003
CODE_SERVICE_PORT=4004
BOARD_SERVICE_PORT=4005
PROJECT_SERVICE_PORT=4006
NOTIFICATION_SERVICE_PORT=4007
AI_SERVICE_PORT=4008

# Frontend. These are baked into the client bundle at build time, so they must
# be the URLs a BROWSER can reach — not Docker service names.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Token lifetimes (the service code reads these names)
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AI. Optional — leave blank and the AI features degrade rather than crash.
ANTHROPIC_API_KEY=
AI_MODEL=gemini-1.5-pro
AI_MAX_TOKENS=4096

# OAuth. Optional; blank disables those sign-in buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email. Optional; blank means notification emails are logged, not sent.
SMTP_PASSWORD=
SMTP_FROM=noreply@collabspace.local

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3001

# Misc
LOG_LEVEL=info
IMAGE_TAG=latest
